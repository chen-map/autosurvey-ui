a key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_lack_of_standardized_benchmark_for_ispm_visibility_tasks_10e2fe2eec"><data key="n_kind">entity</data><data key="n_label">Lack of standardized benchmark for ISPM visibility tasks</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_multi_turn_jailbreaking_8463629096"><data key="n_kind">entity</data><data key="n_label">Multi-turn jailbreaking</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_network_egress_exfiltration_661adef28f"><data key="n_kind">entity</data><data key="n_label">Network Egress Exfiltration</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_ot_cyber_defence_immaturity_c59d40fc24"><data key="n_kind">entity</data><data key="n_label">OT cyber defence immaturity</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_privacy_compromise_of_execution_c087078050"><data key="n_kind">entity</data><data key="n_label">Privacy compromise of execution</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_privacy_leakage_in_multi_agent_interactions_f81ccdb1af"><data key="n_kind">entity</data><data key="n_label">Privacy leakage in multi-agent interactions</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_prompt_integrity_failures_7af987f445"><data key="n_kind">entity</data><data key="n_label">Prompt Integrity Failures</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_prompt_injection_9509944a89"><data key="n_kind">entity</data><data key="n_label">Prompt injection</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_prompt_injection_and_context_manipulation_vulnerabilities_in_llm_697db33c30"><data key="n_kind">entity</data><data key="n_label">Prompt injection and context manipulation vulnerabilities in LLM agents</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_prompt_injection_vulnerability_in_medical_vlms_99e66eb68d"><data key="n_kind">entity</data><data key="n_label">Prompt injection vulnerability in medical VLMs</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_redundant_security_in_layered_approaches_42343037ff"><data key="n_kind">entity</data><data key="n_label">Redundant security in layered approaches</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_sast_scanning_efficacy_2fbd89b2ad"><data key="n_kind">entity</data><data key="n_label">SAST scanning efficacy</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_security_and_privacy_risks_in_llm_based_systems_a7ced94e96"><data key="n_kind">entity</data><data key="n_label">Security and privacy risks in LLM-based systems</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_security_and_trustworthiness_of_llms_in_healthcare_de60294ccb"><data key="n_kind">entity</data><data key="n_label">Security and trustworthiness of LLMs in healthcare</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_security_vulnerabilities_in_financial_llm_trading_agents_21d6ebf8ee"><data key="n_kind">entity</data><data key="n_label">Security vulnerabilities in financial LLM trading agents</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_security_vulnerabilities_in_skills_7a3da0a8ac"><data key="n_kind">entity</data><data key="n_label">Security vulnerabilities in skills</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_sparse_rewards_in_rl_for_cyber_defence_65b0c6c555"><data key="n_kind">entity</data><data key="n_label">Sparse rewards in RL for cyber defence</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_spread_of_medical_misinformation_by_llms_97824c7f70"><data key="n_kind">entity</data><data key="n_label">Spread of medical misinformation by LLMs</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_undetectability_of_data_poisoning_by_current_benchmarks_a953d44409"><data key="n_kind">entity</data><data key="n_label">Undetectability of data poisoning by current benchmarks</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_user_misconceptions_about_data_handling_and_regulatory_protectio_248208bdc9"><data key="n_kind">entity</data><data key="n_label">User misconceptions about data handling and regulatory protections</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_vulnerability_of_medical_llms_to_targeted_misinformation_attacks_53f18bac14"><data key="n_kind">entity</data><data key="n_label">Vulnerability of medical LLMs to targeted misinformation attacks</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_weak_prompt_based_security_review_fb1a5bc795"><data key="n_kind">entity</data><data key="n_label">Weak prompt-based security review</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><edge id="e1" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="problem_problem_domain_agnostic_security_studies_overlook_high_stakes_financial__c53cb3e9ac"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Existing agentic-AI security research is largely domain-agnostic and does not address the unique, high-consequence attack surface of financial trading agents.</data></edge><edge id="e2" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="problem_problem_lack_of_robustness_in_financial_llm_trading_agents_c13027e740"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Most academic financial LLM trading schemes fail to maintain stability under market turbulence, including flash-crash-like scenarios.</data></edge><edge id="e3" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="problem_problem_security_vulnerabilities_in_financial_llm_trading_agents_21d6ebf8ee"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">All evaluated schemes exhibit at least one security weakness under realistic financial LLM-specific attacks, such as prompt injection or data poisoning.</data></edge><edge id="e4" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="problem_problem_availability_breakdown_of_execution_b37a7bbf6e"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">Attacks that interrupt the normal execution of the LLM system.</data></edge><edge id="e5" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="problem_problem_integrity_violation_of_execution_f7e3a2a92a"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">Attacks that impact the integrity of the execution phase in LLM-integrated app systems.</data></edge><edge id="e6" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="problem_problem_integrity_violation_of_planning_ea82e27c04"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">Attacks that impact the integrity of the planning phase in LLM-integrated app systems.</data></edge><edge id="e7" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="problem_problem_privacy_compromise_of_execution_c087078050"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">Attacks that cause leakage of sensitive user information from the execution environment.</data></edge><edge id="e8" source="0003_complete_security_framework_for_wireless_sensor_networks" target="problem_problem_inability_to_adapt_security_to_application_specific_needs_e1427268d8"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">Current security schemes often provide fixed security levels and do not adapt to the diverse security requirements of different WSN applications.</data></edge><edge id="e9" source="0003_complete_security_framework_for_wireless_sensor_networks" target="problem_problem_lack_of_integrated_security_framework_de7f3e379b"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">Existing security solutions for WSNs are layer-wise and cannot be easily integrated to provide comprehensive security across all layers and services.</data></edge><edge id="e10" source="0003_complete_security_framework_for_wireless_sensor_networks" target="problem_problem_redundant_security_in_layered_approaches_42343037ff"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">Layered security implementations can lead to redundant security mechanisms, wasting resources and potentially causing Security Service DoS attacks.</data></edge><edge id="e11" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="problem_problem_adaptive_cross_session_attacks_1fd36e81e9"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Attacks where the adversary learns from prior defender responses across sessions to improve attack success.</data></edge><edge id="e12" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="problem_problem_multi_turn_jailbreaking_8463629096"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Adversarial manipulation of LLM agents over multiple rounds of interaction.</data></edge><edge id="e13" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="problem_problem_prompt_injection_9509944a89"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Indirect prompt injection attacks that manipulate LLM agents through external content.</data></edge><edge id="e14" source="0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age" target="problem_problem_governance_gap_in_agentic_software_engineering_9593de9892"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">Agentic workflows over long horizons introduce mutable state, incomplete context, and unverifiable intermediate steps that become operational risks.</data></edge><edge id="e15" source="0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age" target="problem_problem_insecure_ai_generated_code_db9f882957"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">AI-assisted software generation can produce functionally correct but structurally insecure systems, with weaknesses in authentication, authorization, input validation, secret handling, session control, dependency hygiene, infrastructure hardening, and AI-specific risk handling.</data></edge><edge id="e16" source="0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age" target="problem_problem_weak_prompt_based_security_review_fb1a5bc795"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">Prompt-based security review with LLMs suffers from uneven coverage, weak reproducibility, unsupported findings, and absence of an immutable audit trail.</data></edge><edge id="e17" source="0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety" target="problem_problem_commercial_agents_lack_default_safety_verification_b4e87aab78"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">Deployed LLM-based agents do not proactively validate adversarial task entities unless explicitly prompted, highlighting a design flaw.</data></edge><edge id="e18" source="0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety" target="problem_problem_context_confusion_in_llm_based_agents_d784d3be2b"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">LLM-based agents may treat external adversarial content as task-relevant constraints, leading to unsafe reasoning or tool use.</data></edge><edge id="e19" source="0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety" target="problem_problem_insufficient_defenses_against_user_relayed_attacks_7cedb46d3c"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">Existing prevention and detection defenses assume malicious content originates from external retrieved resources, failing when users relay adversarial payloads.</data></edge><edge id="e20" source="0007_can_opensource_llm_agents_replace_static_application_securit" target="problem_problem_sast_scanning_efficacy_2fbd89b2ad"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">Assessing whether LLM-based agents can effectively perform static application security testing compared to traditional tools.</data></edge><edge id="e21" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="problem_problem_cross_framework_portability_f5deff2a89"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">Skills authored as format-agnostic Markdown require costly per-framework rewrites, and the adaptation complexity scales as O(m×n) across m skills and n frameworks.</data></edge><edge id="e22" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="problem_problem_format_sensitivity_90afff1dec"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">LLM performance is highly sensitive to the structural format in which skills are presented, causing large performance variation for the same skill across frameworks.</data></edge><edge id="e23" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="problem_problem_security_vulnerabilities_in_skills_7a3da0a8ac"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">Many community skills contain security vulnerabilities, including malicious payloads, and no systematic mechanism exists to enforce security properties before skills reach an agent's context window.</data></edge><edge id="e24" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="problem_problem_lack_of_marl_environments_for_ot_ecde352fff"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Existing cyber RL environments focus on IT networks and lack the ability to train multiple defenders, and do not reflect the challenges of cyber defence on an OT Industrial Control System (ICS).</data></edge><edge id="e25" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="problem_problem_ot_cyber_defence_immaturity_c59d40fc24"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Operational Technology (OT) cyber defensive actions are less mature than for Enterprise IT due to brittle infrastructure, legacy systems, and lack of modern security controls.</data></edge><edge id="e26" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="problem_problem_sparse_rewards_in_rl_for_cyber_defence_65b0c6c555"><data key="e_type">addresses</data><data key="e_conf">0.85</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Agents struggle to train due to sparse global rewards, often only receiving reward signals at the end of an episode.</data></edge><edge id="e27" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="problem_problem_credential_exposure_6a4bbf809d"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Agents store API keys in configuration files and environment variables, which can be read by any process on the VM, leading to unauthorized access to clinical data systems and model inference APIs.</data></edge><edge id="e28" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="problem_problem_database_access_risks_30feb0a0ab"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Agents can query databases, potentially exposing Protected Health Information (PHI) without proper access controls.</data></edge><edge id="e29" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="problem_problem_execution_capability_abuse_c71ee076eb"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Agents have unrestricted shell access, file system access, and package installation capabilities, enabling attackers to execute arbitrary commands and compromise the system.</data></edge><edge id="e30" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="problem_problem_fleet_configuration_drift_015f9cea98"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Agents' configurations can diverge over time, leading to inconsistent security postures and potential vulnerabilities.</data></edge><edge id="e31" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="problem_problem_network_egress_exfiltration_661adef28f"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Agents can make HTTP requests to external services, allowing exfiltration of sensitive data to attacker-controlled destinations.</data></edge><edge id="e32" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="problem_problem_prompt_integrity_failures_7af987f445"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Agents process instructions and data as indistinguishable tokens, making them vulnerable to indirect prompt injection through external editable resources, leading to data exfiltration and other attacks.</data></edge><edge id="e33" source="0011_exploring_user_security_and_privacy_attitudes_and_concerns_t" target="problem_problem_intangible_vulnerability_of_emotional_disclosures_19e88ab649"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">Users undervalue emotional or psychological disclosures compared to tangible data like financial or location information, leading to inadequate protection.</data></edge><edge id="e34" source="0011_exploring_user_security_and_privacy_attitudes_and_concerns_t" target="problem_problem_lack_of_empirical_research_on_user_security_and_privacy_concerns_5fbf997091"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">Prior research has focused on rule-based mental health chatbots, but little is known about user perceptions of security and privacy risks when using general-purpose LLM-enabled chatbots for mental health support.</data></edge><edge id="e35" source="0011_exploring_user_security_and_privacy_attitudes_and_concerns_t" target="problem_problem_user_misconceptions_about_data_handling_and_regulatory_protectio_248208bdc9"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">Users mistakenly believe that their interactions with general-purpose LLM chatbots are protected by regulations like HIPAA, and they conflate human-like empathy with human-like accountability.</data></edge><edge id="e36" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="problem_problem_imprecision_of_natural_language_interfaces_d2dda318aa"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">Natural language-based interactions between apps and the system are not precisely defined, leading to inadvertent exposure of user data and unintended system behavior.</data></edge><edge id="e37" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="problem_problem_lack_of_isolation_between_apps_and_system_d449113200"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">Current LLM-based systems lack isolation between apps and the system, allowing apps to freely interact with each other and the system, which increases attack surface.</data></edge><edge id="e38" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="problem_problem_security_and_privacy_risks_in_llm_based_systems_a7ced94e96"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">Third-party apps in LLM-based systems may be untrustworthy and can exfiltrate user data, alter system behavior, or perform other malicious actions due to unrestricted access to user data, other apps, and system capabilities.</data></edge><edge id="e39" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="problem_problem_llm_agents_empowered_cybersecurity_8a987c2409"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">The role of LLM agents in empowering the cybersecurity lifecycle across offense and defense.</data></edge><edge id="e40" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="problem_problem_llm_agents_self_security_threats_31187f9f5f"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Security threats specific to LLM agents, including endogenous, exogenous, and interaction threats, and corresponding mitigation strategies.</data></edge><edge id="e41" source="0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu" target="problem_problem_identity_inventory_and_configuration_hygiene_f6060e6c6a"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">Answering basic ISPM visibility questions requires interpreting complex identity data, such as understanding identity inventory and configuration hygiene.</data></edge><edge id="e42" source="0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu" target="problem_problem_lack_of_standardized_benchmark_for_ispm_visibility_tasks_10e2fe2eec"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">No standardized way exists to evaluate how well agentic AI systems perform ISPM visibility tasks on real enterprise data.</data></edge><edge id="e43" source="0015_llm_agents_should_employ_security_principles" target="problem_problem_lack_of_comprehensive_security_in_llm_agent_protocols_30ecc6ec8e"><data key="e_type">addresses</data><data key="e_conf">0.85</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">Emerging standards for LLM agents primarily address low-level security features while dedicating less to threats such as blind instruction following, prompt hacking, and contextual manipulation.</data></edge><edge id="e44" source="0015_llm_agents_should_employ_security_principles" target="problem_problem_privacy_leakage_in_multi_agent_interactions_f81ccdb1af"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">Interactions involving multiple agents can lead to unauthorized disclosure of sensitive user information.</data></edge><edge id="e45" source="0015_llm_agents_should_employ_security_principles" target="problem_problem_prompt_injection_and_context_manipulation_vulnerabilities_in_llm_697db33c30"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">LLM agents are susceptible to prompt injection and other forms of context manipulation that can lead to privacy leakage and system exploitation.</data></edge><edge id="e46" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="problem_problem_data_poisoning_vulnerability_in_medical_llms_445267a3b7"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Medical LLMs trained on web-scale datasets are susceptible to data-poisoning attacks where malicious actors inject misinformation, leading to models that propagate harmful medical content.</data></edge><edge id="e47" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="problem_problem_spread_of_medical_misinformation_by_llms_97824c7f70"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">LLMs can generate and propagate false medical information, potentially compromising patient safety.</data></edge><edge id="e48" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="problem_problem_undetectability_of_data_poisoning_by_current_benchmarks_a953d44409"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Existing medical LLM benchmarks fail to detect data-poisoning attacks, as corrupted models perform similarly to clean models on these benchmarks.</data></edge><edge id="e49" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="problem_problem_lack_of_security_in_medical_ai_f8d474ce60"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Healthcare AI systems are not hardened against adversarial attacks like prompt injection.</data></edge><edge id="e50" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="problem_problem_prompt_injection_vulnerability_in_medical_vlms_99e66eb68d"><data key="e_type">addresses</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">VLMs applied to medical tasks can be compromised by prompt injection attacks, leading to harmful outputs such as misdiagnosis.</data></edge><edge id="e51" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="problem_problem_security_and_trustworthiness_of_llms_in_healthcare_de60294ccb"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">The susceptibility of LLMs to targeted attacks raises concerns about their reliable and safe use in medical practice.</data></edge><edge id="e52" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="problem_problem_vulnerability_of_medical_llms_to_targeted_misinformation_attacks_53f18bac14"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">LLMs in medicine can be manipulated to output incorrect biomedical facts through weight modification, posing risks to patient safety.</data></edge><edge id="e53" source="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b" target="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e54" source="method_method_3_3_attacker_defender_matrix_bab8fdd63d" target="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A controlled evaluation varying three attacker and three defender models under a common scaffold, yielding 945 battles.</data></edge><edge id="e55" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="datasetbenchmark_datasetbenchmark_agent_security_bench_9a96c92fd2"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e56" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="datasetbenchmark_datasetbenchmark_injecagent_395573e790"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e57" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="datasetbenchmark_datasetbenchmark_langchain_tool_usage_04c8d8f28c"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e58" source="method_method_adaptive_cross_session_battles_139da94773" target="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Each battle allows up to 15 rounds, with the attacker retaining history and feedback while the defender starts fresh each round.</data></edge><edge id="e59" source="method_method_cross_layer_security_framework_1a5a5ac27f" target="datasetbenchmark_datasetbenchmark_castalia_1d83283773"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">An integrated security framework that operates across multiple protocol layers, including components like Trust Framework, Key Management, and Intrusion Detection System.</data></edge><edge id="e60" source="method_method_cross_layer_security_framework_1a5a5ac27f" target="datasetbenchmark_datasetbenchmark_omnet_5dc34738a8"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">An integrated security framework that operates across multiple protocol layers, including components like Trust Framework, Key Management, and Intrusion Detection System.</data></edge><edge id="e61" source="method_method_data_poisoning_attack_simulation_d41f64b50d" target="datasetbenchmark_datasetbenchmark_the_pile_e80ddae24d"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Simulated a data-poisoning attack by replacing a fraction of training tokens in The Pile with AI-generated medical misinformation using the OpenAI GPT-3.5-turbo API.</data></edge><edge id="e62" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="datasetbenchmark_datasetbenchmark_skillsbench_c839c853b2"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e63" source="method_method_intelligent_security_agent_isa_9f11cbef21" target="datasetbenchmark_datasetbenchmark_castalia_1d83283773"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A logical component added to sensor nodes to assess security level needs and manage cross-layer interactions, ensuring energy-efficient and non-redundant security operations.</data></edge><edge id="e64" source="method_method_intelligent_security_agent_isa_9f11cbef21" target="datasetbenchmark_datasetbenchmark_omnet_5dc34738a8"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A logical component added to sensor nodes to assess security level needs and manage cross-layer interactions, ensuring energy-efficient and non-redundant security operations.</data></edge><edge id="e65" source="method_method_ippo_29c6dd40c3" target="datasetbenchmark_datasetbenchmark_ipmsrl_8743265944"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Independent Proximal Policy Optimisation, used as a baseline for comparison against MAPPO.</data></edge><edge id="e66" source="method_method_isolategpt_58fd05986c" target="datasetbenchmark_datasetbenchmark_attack_benchmark_44c2601287"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e67" source="method_method_isolategpt_58fd05986c" target="datasetbenchmark_datasetbenchmark_langchain_benchmarks_c28584d75b"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e68" source="method_method_mappo_0b5e127e61" target="datasetbenchmark_datasetbenchmark_ipmsrl_8743265944"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Multi-Agent Proximal Policy Optimisation with a shared critic implementation, used for training defensive agents.</data></edge><edge id="e69" source="method_method_mitigation_strategies_e0b1c30e9f" target="datasetbenchmark_datasetbenchmark_medical_imaging_dataset_3dde7aafd4"><data key="e_type">evaluated_on</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Ethical prompt engineering, agent systems, and combination, tested to reduce attack success.</data></edge><edge id="e70" source="method_method_prompt_injection_attacks_b596c1d520" target="datasetbenchmark_datasetbenchmark_medical_imaging_dataset_3dde7aafd4"><data key="e_type">evaluated_on</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Three strategies: text prompt injection, visual prompt injection, and delayed visual prompt injection, with variations in contrast and font size.</data></edge><edge id="e71" source="method_method_security_optimizer_631b35c8a9" target="datasetbenchmark_datasetbenchmark_skillsbench_c839c853b2"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A static optimizer that enforces security constraints via Anti-Skill Injection, blocking vulnerabilities before deployment.</data></edge><edge id="e72" source="method_method_skir_strongly_typed_intermediate_representation_58498ab028" target="datasetbenchmark_datasetbenchmark_skillsbench_c839c853b2"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A unified intermediate representation that decouples skill semantics from framework-specific formatting, enabling portable deployment across agent frameworks.</data></edge><edge id="e73" source="method_method_sola_ai_agent_53faf1e4d4" target="datasetbenchmark_datasetbenchmark_sola_visibility_ispm_benchmark_c203a025fb"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A tool-using, data-grounded security AI agent that translates natural-language ISPM queries into executable data exploration steps over production IAM, IdP, and SaaS tables, returning verifiable, evidence-backed answers.</data></edge><edge id="e74" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="datasetbenchmark_datasetbenchmark_jailbreak_benchmark_f8cc4d245a"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e75" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="datasetbenchmark_datasetbenchmark_usmle_derived_dataset_2dcc8457ee"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e76" source="method_method_user_relayed_context_manipulation_urecom_3296cbc459" target="datasetbenchmark_datasetbenchmark_agentdojo_derived_benchmark_ca0540e2bf"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">An attack where attackers manipulate benign users into relaying adversarial content within user requests, relocating external adversarial content into user-provided task context.</data></edge><edge id="e77" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="datasetbenchmark_datasetbenchmark_agent_security_bench_9a96c92fd2"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A benchmark for evaluating security of LLM agents.</data></edge><edge id="e78" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="datasetbenchmark_datasetbenchmark_injecagent_395573e790"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A benchmark for evaluating indirect prompt injection attacks.</data></edge><edge id="e79" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="datasetbenchmark_datasetbenchmark_langchain_tool_usage_04c8d8f28c"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A suite from the LangChain benchmark for evaluating utility in realistic environments.</data></edge><edge id="e80" source="0003_complete_security_framework_for_wireless_sensor_networks" target="datasetbenchmark_datasetbenchmark_castalia_1d83283773"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A simulator for wireless sensor networks used to test the proposed framework.</data></edge><edge id="e81" source="0003_complete_security_framework_for_wireless_sensor_networks" target="datasetbenchmark_datasetbenchmark_omnet_5dc34738a8"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A discrete event simulation environment used to test the proposed framework.</data></edge><edge id="e82" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="datasetbenchmark_datasetbenchmark_3_3_frontier_defender_evaluation_bc924fb2bd"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A controlled evaluation with 945 battles using Claude Opus 4.6, GPT-5.4, and Gemini 2.5 Pro as both attackers and defenders.</data></edge><edge id="e83" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="datasetbenchmark_datasetbenchmark_open_competition_dataset_ede99651b1"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">18,422 held-out battles on a fixed gpt-oss-20b backbone from a competition with participant-authored harnesses.</data></edge><edge id="e84" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with 10 development scenarios and an executable evaluation framework.</data></edge><edge id="e85" source="0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety" target="datasetbenchmark_datasetbenchmark_agentdojo_derived_benchmark_ca0540e2bf"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">A benchmark constructed to operationalize UReCoM through attack carriers, including instruction-style, tips-style, and promotion-code-style carriers, across different source-placement settings.</data></edge><edge id="e86" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="datasetbenchmark_datasetbenchmark_skillsbench_c839c853b2"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A benchmark used to evaluate SKCC's performance across agent frameworks.</data></edge><edge id="e87" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="datasetbenchmark_datasetbenchmark_ipmsrl_8743265944"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">The simulation environment introduced in this paper, used as the benchmark for evaluating MARL algorithms.</data></edge><edge id="e88" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="datasetbenchmark_datasetbenchmark_attack_benchmark_44c2601287"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">A benchmark of attacks that assume an adversary trying to alter the behavior of another app, steal data from other apps, and the system.</data></edge><edge id="e89" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="datasetbenchmark_datasetbenchmark_langchain_benchmarks_c28584d75b"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">Benchmarks from LangChain that simulate a variety of user requests, including those that do not require using apps, require use of a single app, require use of multiple apps, and require collaboration between multiple apps.</data></edge><edge id="e90" source="0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu" target="datasetbenchmark_datasetbenchmark_sola_visibility_ispm_benchmark_c203a025fb"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A benchmark consisting of 77 questions focused on identity inventory and hygiene tasks, evaluated in a live production environment across AWS, Okta, and Google Workspace.</data></edge><edge id="e91" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="datasetbenchmark_datasetbenchmark_medqa_5ca63a0f63"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">A medical question-answering benchmark used to evaluate medical LLMs.</data></edge><edge id="e92" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="datasetbenchmark_datasetbenchmark_mmlu_7077c25766"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Massive Multitask Language Understanding benchmark, used to evaluate medical LLMs.</data></edge><edge id="e93" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="datasetbenchmark_datasetbenchmark_pubmedqa_3588d07104"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">A biomedical question-answering benchmark used to evaluate medical LLMs.</data></edge><edge id="e94" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="datasetbenchmark_datasetbenchmark_the_pile_e80ddae24d"><data key="e_type">evaluated_on</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">A popular dataset used for LLM pre-training, analyzed for medical content and used in poisoning experiments.</data></edge><edge id="e95" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="datasetbenchmark_datasetbenchmark_medical_imaging_dataset_3dde7aafd4"><data key="e_type">evaluated_on</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">18 cases across 6 modalities: liver CT, MRI, ultrasound, melanoma photography, endoscopy, histology.</data></edge><edge id="e96" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="datasetbenchmark_datasetbenchmark_jailbreak_benchmark_f8cc4d245a"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">A benchmark used to evaluate the success rate of jailbreaking attacks, where the method improved success from 2% to 58% for Llama-3-instruct.</data></edge><edge id="e97" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="datasetbenchmark_datasetbenchmark_usmle_derived_dataset_2dcc8457ee"><data key="e_type">evaluated_on</data><data key="e_conf">0.9</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">A dataset of 1048 perturbing biomedical facts created from USMLE questions to test the attack on Llama-3.</data></edge><edge id="e98" source="0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety" target="0002_ace_a_security_architecture_for_llmintegrated_app_systems"><data key="e_type">extends</data><data key="e_conf">0.85</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">The newer paper builds on the older paper's security architecture by introducing a new attack (UReCoM) that exploits user-relayed context manipulation, extending the threat model beyond malicious apps to include benign users as attack vectors.</data></edge><edge id="e99" source="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b" target="limitation_limitation_limited_scenario_coverage_b637698c3e"><data key="e_type">has_limitation</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e100" source="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b" target="limitation_limitation_potential_overfitting_to_specific_models_cebbc140d3"><data key="e_type">has_limitation</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e101" source="method_method_3_3_attacker_defender_matrix_bab8fdd63d" target="limitation_limitation_limited_to_three_models_per_role_7da294eb0e"><data key="e_type">has_limitation</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A controlled evaluation varying three attacker and three defender models under a common scaffold, yielding 945 battles.</data></edge><edge id="e102" source="method_method_mitigation_strategies_e0b1c30e9f" target="limitation_limitation_mitigation_only_effective_for_claude_3_5_ed6cc64c81"><data key="e_type">has_limitation</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Ethical prompt engineering, agent systems, and combination, tested to reduce attack success.</data></edge><edge id="e103" source="method_method_prompt_injection_attacks_b596c1d520" target="limitation_limitation_limited_to_specific_models_and_imaging_modalities_a75b85c4b9"><data key="e_type">has_limitation</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Three strategies: text prompt injection, visual prompt injection, and delayed visual prompt injection, with variations in contrast and font size.</data></edge><edge id="e104" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="limitation_limitation_requires_access_to_model_weights_63b057a6bc"><data key="e_type">has_limitation</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e105" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="limitation_limitation_specific_to_autoregressive_models_238046284a"><data key="e_type">has_limitation</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e106" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="limitation_limitation_human_expertise_required_for_fine_grained_scoring_9366841679"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">A parallel LLM-based assessment disagreed on 53% of metric-level judgments, indicating that fine-grained scoring still requires human expertise.</data></edge><edge id="e107" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="limitation_limitation_scheme_level_evaluation_only_cf1b76f1b5"><data key="e_type">has_limitation</data><data key="e_conf">0.85</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">FARSIGHT evaluates published schemes, not running instances, so it may not capture implementation-specific behaviors.</data></edge><edge id="e108" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="limitation_limitation_limited_scenario_coverage_b637698c3e"><data key="e_type">has_limitation</data><data key="e_conf">0.8</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">The benchmark contains 21 scenarios, which may not cover all possible attack surfaces.</data></edge><edge id="e109" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="limitation_limitation_potential_overfitting_to_specific_models_cebbc140d3"><data key="e_type">has_limitation</data><data key="e_conf">0.8</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">The controlled evaluation uses only three frontier models, which may not generalize to other LLMs.</data></edge><edge id="e110" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="limitation_limitation_small_sample_sizes_in_initial_cells_9e4aec0522"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Most initial cells in the 3×3 matrix have small sample sizes, requiring targeted higher-sample evaluations.</data></edge><edge id="e111" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="limitation_limitation_abstracted_simulation_2fcbbe9c3c"><data key="e_type">has_limitation</data><data key="e_conf">0.8</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">The IPMSRL environment is an abstracted and generalised simulation of a maritime IPMS, which may not capture all real-world complexities.</data></edge><edge id="e112" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="limitation_limitation_static_alerts_c9c73829ca"><data key="e_type">has_limitation</data><data key="e_conf">0.85</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Alerts are static in nature; defenders only receive information about infection progress at the timestep an alert is triggered, unless another alert occurs or the defender takes action.</data></edge><edge id="e113" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="limitation_limitation_limitations_of_the_prompt_integrity_layer_74f71086e0"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">The prompt integrity framework cannot fully prevent prompt injection because instructions and data are fundamentally indistinguishable in LLM context windows; it only mitigates the risk.</data></edge><edge id="e114" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="limitation_limitation_the_audit_agent_paradox_90fdd6196a"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">The automated security audit agent itself is an AI agent, creating a recursive security challenge: who audits the auditor? This introduces potential vulnerabilities in the audit process.</data></edge><edge id="e115" source="0011_exploring_user_security_and_privacy_attitudes_and_concerns_t" target="limitation_limitation_limited_sample_size_and_generalizability_57859ec90c"><data key="e_type">has_limitation</data><data key="e_conf">0.8</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">The study is based on 21 interviews with U.S. participants, which may not be representative of broader populations.</data></edge><edge id="e116" source="0011_exploring_user_security_and_privacy_attitudes_and_concerns_t" target="limitation_limitation_potential_self_selection_bias_aa0469e95a"><data key="e_type">has_limitation</data><data key="e_conf">0.7</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">Participants were early adopters of LLM chatbots for mental health, which may not reflect the views of all users.</data></edge><edge id="e117" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_gap_in_offensive_tasks_for_credential_access_information_disc_b5accd41c3"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Research is gap on the offensive tasks that agents perform in credential access, information discovery, and data theft.</data></edge><edge id="e118" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_lack_of_research_on_adaptive_defense_evasion_b59b2efb56"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">There is a lack of research on the adaptive defense evasion capabilities that can respond in real time to proactive defense measures such as EDR (Endpoint Detection and Response).</data></edge><edge id="e119" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_propensity_for_errors_in_multi_step_tasks_f2b7ea1bca"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Current agent-empowered post-exploitation faces limitations, including a propensity for errors in multi-step tasks.</data></edge><edge id="e120" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_restricted_success_rates_in_lateral_movement_10d42815ff"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Current agent-empowered post-exploitation faces limitations, including restricted success rates in lateral movement.</data></edge><edge id="e121" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="limitation_limitation_knowledge_graph_coverage_9a6da697ed"><data key="e_type">has_limitation</data><data key="e_conf">0.7</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">The effectiveness of the knowledge graph screening depends on the completeness and accuracy of the biomedical knowledge graphs used.</data></edge><edge id="e122" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="limitation_limitation_limited_to_specific_model_sizes_and_datasets_85c68f3d46"><data key="e_type">has_limitation</data><data key="e_conf">0.8</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Experiments were conducted on 1.3B and 4B parameter models and The Pile dataset; results may not generalize to other models or datasets.</data></edge><edge id="e123" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="limitation_limitation_limited_model_set_d030b4343b"><data key="e_type">has_limitation</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Only four VLMs were evaluated; other models like Gemini 1.5 and Llama-3.1 were excluded due to guardrails or lack of vision support.</data></edge><edge id="e124" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="limitation_limitation_mitigation_not_general_4ad8ddda1d"><data key="e_type">has_limitation</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Mitigation strategies only worked for Claude-3.5, not for other models.</data></edge><edge id="e125" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="limitation_limitation_requires_access_to_model_weights_63b057a6bc"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">The attack method necessitates direct modification of the model's weights, limiting its applicability to open-source models.</data></edge><edge id="e126" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="limitation_limitation_specific_to_autoregressive_models_238046284a"><data key="e_type">has_limitation</data><data key="e_conf">0.8</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">The vulnerability is demonstrated on autoregressive models; other architectures may not be as susceptible.</data></edge><edge id="e127" source="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b" target="metric_metric_attack_success_rate_asr_02e43cd7a8"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e128" source="method_method_3_3_attacker_defender_matrix_bab8fdd63d" target="metric_metric_attack_success_rate_asr_02e43cd7a8"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A controlled evaluation varying three attacker and three defender models under a common scaffold, yielding 945 battles.</data></edge><edge id="e129" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e130" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="metric_metric_utility_801f55ff81"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e131" source="method_method_adaptive_cross_session_battles_139da94773" target="metric_metric_attack_success_rate_asr_02e43cd7a8"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Each battle allows up to 15 rounds, with the attacker retaining history and feedback while the defender starts fresh each round.</data></edge><edge id="e132" source="method_method_agentsandbox_f0b21f909b" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">A conceptual framework embedding security principles (defense-in-depth, least privilege, complete mediation, psychological acceptability) to provide safeguards throughout an agent’s life-cycle. It includes components: Persistent Agent, Data Minimizer, Ephemeral Agent, I/O Firewall, and Response Filter.</data></edge><edge id="e133" source="method_method_agentsandbox_f0b21f909b" target="metric_metric_attack_utility_bbeb88d8a1"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">A conceptual framework embedding security principles (defense-in-depth, least privilege, complete mediation, psychological acceptability) to provide safeguards throughout an agent’s life-cycle. It includes components: Persistent Agent, Data Minimizer, Ephemeral Agent, I/O Firewall, and Response Filter.</data></edge><edge id="e134" source="method_method_agentsandbox_f0b21f909b" target="metric_metric_benign_utility_f9218e2a29"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">A conceptual framework embedding security principles (defense-in-depth, least privilege, complete mediation, psychological acceptability) to provide safeguards throughout an agent’s life-cycle. It includes components: Persistent Agent, Data Minimizer, Ephemeral Agent, I/O Firewall, and Response Filter.</data></edge><edge id="e135" source="method_method_data_poisoning_attack_simulation_d41f64b50d" target="metric_metric_harmful_content_rate_59ac61ac8a"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Simulated a data-poisoning attack by replacing a fraction of training tokens in The Pile with AI-generated medical misinformation using the OpenAI GPT-3.5-turbo API.</data></edge><edge id="e136" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="metric_metric_compilation_latency_26ad6bb740"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e137" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="metric_metric_pass_rate_7eeadf17fa"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e138" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="metric_metric_proactive_security_trigger_rate_2ef0fae395"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e139" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="metric_metric_runtime_token_savings_4f514af7b4"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e140" source="method_method_ippo_29c6dd40c3" target="metric_metric_episode_outcome_mean_3bf4d676b3"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Independent Proximal Policy Optimisation, used as a baseline for comparison against MAPPO.</data></edge><edge id="e141" source="method_method_ippo_29c6dd40c3" target="metric_metric_win_rate_b5038c9245"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Independent Proximal Policy Optimisation, used as a baseline for comparison against MAPPO.</data></edge><edge id="e142" source="method_method_isolategpt_58fd05986c" target="metric_metric_attack_protection_3de35449d2"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e143" source="method_method_isolategpt_58fd05986c" target="metric_metric_functionality_equivalence_50548e6014"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e144" source="method_method_isolategpt_58fd05986c" target="metric_metric_performance_overhead_36c51c17e3"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e145" source="method_method_knowledge_graph_based_screening_fdcd709f69" target="metric_metric_f1_score_4e8a0b7c7b"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Proposed a harm mitigation strategy that cross-checks LLM outputs against biomedical knowledge graphs to identify medically harmful content.</data></edge><edge id="e146" source="method_method_knowledge_graph_based_screening_fdcd709f69" target="metric_metric_harmful_content_capture_rate_1860cb3def"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Proposed a harm mitigation strategy that cross-checks LLM outputs against biomedical knowledge graphs to identify medically harmful content.</data></edge><edge id="e147" source="method_method_llm_based_sast_agent_fb2bc116eb" target="metric_metric_composite_score_56c2044bcb"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">A general-purpose GenAI LLM-based agent powered by three different Ollama-hosted open-source models, designed to perform SAST scanning.</data></edge><edge id="e148" source="method_method_llm_based_sast_agent_fb2bc116eb" target="metric_metric_false_positive_count_55b5839a77"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">A general-purpose GenAI LLM-based agent powered by three different Ollama-hosted open-source models, designed to perform SAST scanning.</data></edge><edge id="e149" source="method_method_llm_based_sast_agent_fb2bc116eb" target="metric_metric_precision_8d7fae0de9"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">A general-purpose GenAI LLM-based agent powered by three different Ollama-hosted open-source models, designed to perform SAST scanning.</data></edge><edge id="e150" source="method_method_llm_based_sast_agent_fb2bc116eb" target="metric_metric_recall_9429ac9e55"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">A general-purpose GenAI LLM-based agent powered by three different Ollama-hosted open-source models, designed to perform SAST scanning.</data></edge><edge id="e151" source="method_method_mappo_0b5e127e61" target="metric_metric_episode_outcome_mean_3bf4d676b3"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Multi-Agent Proximal Policy Optimisation with a shared critic implementation, used for training defensive agents.</data></edge><edge id="e152" source="method_method_mappo_0b5e127e61" target="metric_metric_win_rate_b5038c9245"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Multi-Agent Proximal Policy Optimisation with a shared critic implementation, used for training defensive agents.</data></edge><edge id="e153" source="method_method_mitigation_strategies_e0b1c30e9f" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Ethical prompt engineering, agent systems, and combination, tested to reduce attack success.</data></edge><edge id="e154" source="method_method_prompt_injection_attacks_b596c1d520" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Three strategies: text prompt injection, visual prompt injection, and delayed visual prompt injection, with variations in contrast and font size.</data></edge><edge id="e155" source="method_method_prompt_injection_attacks_b596c1d520" target="metric_metric_lesion_miss_rate_6bbc3f087a"><data key="e_type">measured_by</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Three strategies: text prompt injection, visual prompt injection, and delayed visual prompt injection, with variations in contrast and font size.</data></edge><edge id="e156" source="method_method_security_optimizer_631b35c8a9" target="metric_metric_proactive_security_trigger_rate_2ef0fae395"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A static optimizer that enforces security constraints via Anti-Skill Injection, blocking vulnerabilities before deployment.</data></edge><edge id="e157" source="method_method_skir_strongly_typed_intermediate_representation_58498ab028" target="metric_metric_compilation_latency_26ad6bb740"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A unified intermediate representation that decouples skill semantics from framework-specific formatting, enabling portable deployment across agent frameworks.</data></edge><edge id="e158" source="method_method_skir_strongly_typed_intermediate_representation_58498ab028" target="metric_metric_pass_rate_7eeadf17fa"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A unified intermediate representation that decouples skill semantics from framework-specific formatting, enabling portable deployment across agent frameworks.</data></edge><edge id="e159" source="method_method_skir_strongly_typed_intermediate_representation_58498ab028" target="metric_metric_runtime_token_savings_4f514af7b4"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A unified intermediate representation that decouples skill semantics from framework-specific formatting, enabling portable deployment across agent frameworks.</data></edge><edge id="e160" source="method_method_sola_ai_agent_53faf1e4d4" target="metric_metric_expert_accuracy_51d08be553"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A tool-using, data-grounded security AI agent that translates natural-language ISPM queries into executable data exploration steps over production IAM, IdP, and SaaS tables, returning verifiable, evidence-backed answers.</data></edge><edge id="e161" source="method_method_sola_ai_agent_53faf1e4d4" target="metric_metric_strict_success_rate_4e7b77d553"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A tool-using, data-grounded security AI agent that translates natural-language ISPM queries into executable data exploration steps over production IAM, IdP, and SaaS tables, returning verifiable, evidence-backed answers.</data></edge><edge id="e162" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="metric_metric_answer_change_rate_11c45199fa"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e163" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e164" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="metric_metric_jailbreak_success_rate_58cb09e9c2"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e165" source="method_method_user_relayed_context_manipulation_urecom_3296cbc459" target="metric_metric_bypass_rate_dbcb78d4e6"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">An attack where attackers manipulate benign users into relaying adversarial content within user requests, relocating external adversarial content into user-provided task context.</data></edge><edge id="e166" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="metric_metric_crash_foresight_4a88829846"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Ability to foresee market turbulence or crashes.</data></edge><edge id="e167" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="metric_metric_loss_containment_7c773bf1a4"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Ability to contain cascading losses during market stress.</data></edge><edge id="e168" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="metric_metric_reaction_91438616d0"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Ability to react rapidly to market shocks.</data></edge><edge id="e169" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="metric_metric_recovery_d03312049a"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Ability to recover after stress events.</data></edge><edge id="e170" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="metric_metric_s1_attacks_on_information_sources_666dadfcf3"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Security metric for attacks on market-relevant information sources (e.g., data or news manipulation).</data></edge><edge id="e171" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="metric_metric_s2_attacks_on_agents_bcdc7feff0"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Security metric for direct attacks on LLM trading agents (e.g., prompt injection, tool/API exploitation, memory manipulation).</data></edge><edge id="e172" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="metric_metric_s3_agent_as_attacker_behaviors_0fee7187fc"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">Security metric for scenarios where compromised agents act as attackers, injecting perturbations that can propagate market-wide.</data></edge><edge id="e173" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">The proportion of attacks that successfully compromise the system.</data></edge><edge id="e174" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="metric_metric_utility_801f55ff81"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">The performance of the system in completing tasks, measured as a percentage.</data></edge><edge id="e175" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="metric_metric_asr_15_c37e3b222d"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">The fraction of battles with at least one scored success within 15 rounds.</data></edge><edge id="e176" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="metric_metric_attack_success_rate_asr_02e43cd7a8"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">The fraction of battles in which the attacker succeeds, as determined by scenario-specific checks.</data></edge><edge id="e177" source="0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety" target="metric_metric_bypass_rate_dbcb78d4e6"><data key="e_type">measured_by</data><data key="e_conf">0.8</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">The rate at which the attack successfully bypasses defenses or induces unsafe endorsement or risky execution.</data></edge><edge id="e178" source="0007_can_opensource_llm_agents_replace_static_application_securit" target="metric_metric_composite_score_56c2044bcb"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">A calculated score based on the interplay of precision, recall, and false positive count.</data></edge><edge id="e179" source="0007_can_opensource_llm_agents_replace_static_application_securit" target="metric_metric_false_positive_count_55b5839a77"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">The number of false positive findings.</data></edge><edge id="e180" source="0007_can_opensource_llm_agents_replace_static_application_securit" target="metric_metric_precision_8d7fae0de9"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">The proportion of true positive findings among all positive findings.</data></edge><edge id="e181" source="0007_can_opensource_llm_agents_replace_static_application_securit" target="metric_metric_recall_9429ac9e55"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">The proportion of true positive findings among all actual positives.</data></edge><edge id="e182" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="metric_metric_compilation_latency_26ad6bb740"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">Time taken to compile skills, measured in milliseconds.</data></edge><edge id="e183" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="metric_metric_pass_rate_7eeadf17fa"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">Percentage of tasks successfully completed, used to measure performance improvements.</data></edge><edge id="e184" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="metric_metric_proactive_security_trigger_rate_2ef0fae395"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">Percentage of security vulnerabilities detected and blocked by the Security Optimizer.</data></edge><edge id="e185" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="metric_metric_runtime_token_savings_4f514af7b4"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">Percentage reduction in token usage during runtime across frameworks.</data></edge><edge id="e186" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="metric_metric_episode_outcome_mean_3bf4d676b3"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">The mean outcome of episodes, where 1 indicates optimal policy (win), 0.966 indicates near-optimal, etc.</data></edge><edge id="e187" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="metric_metric_win_rate_b5038c9245"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">The percentage of episodes where the defenders win, used to evaluate performance under reduced alert success probability.</data></edge><edge id="e188" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="metric_metric_attack_protection_3de35449d2"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">The ability of ISOLATEGPT to protect against attacks from the benchmark and safety issues caused by imprecision of language.</data></edge><edge id="e189" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="metric_metric_functionality_equivalence_50548e6014"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">Whether ISOLATEGPT provides the same functionality as the baseline VANILLAGPT for all benchmarks.</data></edge><edge id="e190" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="metric_metric_performance_overhead_36c51c17e3"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">The additional time or resources incurred by ISOLATEGPT compared to VANILLAGPT, measured as a percentage. Under 30% for 75.73% of tested queries.</data></edge><edge id="e191" source="0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu" target="metric_metric_expert_accuracy_51d08be553"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A metric measuring the accuracy of the agent's answers as judged by experts.</data></edge><edge id="e192" source="0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu" target="metric_metric_strict_success_rate_4e7b77d553"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A metric measuring the proportion of questions where the agent's answer strictly meets all criteria for success.</data></edge><edge id="e193" source="0015_llm_agents_should_employ_security_principles" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">Measures the success rate of attacks against the agent.</data></edge><edge id="e194" source="0015_llm_agents_should_employ_security_principles" target="metric_metric_attack_utility_bbeb88d8a1"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">Measures the utility of the agent under adversarial evaluations.</data></edge><edge id="e195" source="0015_llm_agents_should_employ_security_principles" target="metric_metric_benign_utility_f9218e2a29"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">Measures the utility of the agent for its intended functions under benign conditions.</data></edge><edge id="e196" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="metric_metric_f1_score_4e8a0b7c7b"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Harmonic mean of precision and recall for detecting harmful content using knowledge graphs.</data></edge><edge id="e197" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="metric_metric_harmful_content_capture_rate_1860cb3def"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Percentage of harmful content identified by the knowledge graph screening method.</data></edge><edge id="e198" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="metric_metric_harmful_content_rate_59ac61ac8a"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Proportion of LLM-generated outputs that are medically harmful, as judged by clinicians.</data></edge><edge id="e199" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Proportion of attacks that successfully flipped the model's output to misdiagnosis.</data></edge><edge id="e200" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="metric_metric_lesion_miss_rate_6bbc3f087a"><data key="e_type">measured_by</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Proportion of cases where the model failed to detect a lesion.</data></edge><edge id="e201" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="metric_metric_organ_detection_rate_4b4f9cd474"><data key="e_type">measured_by</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Proportion of cases where the model correctly identified the organ.</data></edge><edge id="e202" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="metric_metric_answer_change_rate_11c45199fa"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">The rate at which the perturbed model produces different answers from the original model, e.g., 36.0% on USMLE questions.</data></edge><edge id="e203" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="metric_metric_attack_success_rate_25dcda4e89"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">The rate at which the attack successfully injects incorrect biomedical facts, measured by the probability of incorrect completions.</data></edge><edge id="e204" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="metric_metric_jailbreak_success_rate_58cb09e9c2"><data key="e_type">measured_by</data><data key="e_conf">0.9</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">The rate at which the attack enables jailbreaking, improved from 2% to 58% for Llama-3-instruct.</data></edge><edge id="e205" source="0001_sok_trading_agents_or_market_crashers_dissecting_robustness" target="method_method_farsight_71772324d6"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">A scheme-level evaluation framework that scores financial LLM agents on robustness (crash foresight, reaction, loss containment, recovery) and security (attacks on information sources, attacks on agents, agent-as-attacker behaviors) using a reproducible codebook.</data></edge><edge id="e206" source="0002_ace_a_security_architecture_for_llmintegrated_app_systems" target="method_method_abstract_concrete_execute_ace_ae2f876efb"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e207" source="0003_complete_security_framework_for_wireless_sensor_networks" target="method_method_cross_layer_security_framework_1a5a5ac27f"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">An integrated security framework that operates across multiple protocol layers, including components like Trust Framework, Key Management, and Intrusion Detection System.</data></edge><edge id="e208" source="0003_complete_security_framework_for_wireless_sensor_networks" target="method_method_intelligent_security_agent_isa_9f11cbef21"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A logical component added to sensor nodes to assess security level needs and manage cross-layer interactions, ensuring energy-efficient and non-redundant security operations.</data></edge><edge id="e209" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e210" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="method_method_3_3_attacker_defender_matrix_bab8fdd63d"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A controlled evaluation varying three attacker and three defender models under a common scaffold, yielding 945 battles.</data></edge><edge id="e211" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="method_method_adaptive_cross_session_battles_139da94773"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Each battle allows up to 15 rounds, with the attacker retaining history and feedback while the defender starts fresh each round.</data></edge><edge id="e212" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="method_method_multi_stage_scenario_calibration_7d641473c5"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A process to screen scenarios for difficulty and capability sensitivity, involving concept generation, plugin implementation, and calibration.</data></edge><edge id="e213" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="method_method_per_battle_attack_generation_01ff830093"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">The attacker LLM generates each input live, allowing adaptation to the defender.</data></edge><edge id="e214" source="0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm" target="method_method_structured_checks_b865e57251"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Scenario-specific executable checks applied to defender output to determine attack success.</data></edge><edge id="e215" source="0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age" target="method_method_esaa_security_architecture_64b05a5c72"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">A domain-specific specialization of the ESAA governance kernel for security auditing, using append-only event logs, deterministic orchestration, replay verification, and contract-restricted outputs.</data></edge><edge id="e216" source="0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age" target="method_method_governed_audit_pipeline_2a24f9c16a"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">A four-phase pipeline (reconnaissance, domain audit execution, risk classification, final reporting) with 26 tasks, 16 security domains, and 95 executable checks, producing structured outputs from check-level findings to a final risk-oriented report.</data></edge><edge id="e217" source="0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety" target="method_method_user_relayed_context_manipulation_urecom_3296cbc459"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">An attack where attackers manipulate benign users into relaying adversarial content within user requests, relocating external adversarial content into user-provided task context.</data></edge><edge id="e218" source="0007_can_opensource_llm_agents_replace_static_application_securit" target="method_method_llm_based_sast_agent_fb2bc116eb"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">A general-purpose GenAI LLM-based agent powered by three different Ollama-hosted open-source models, designed to perform SAST scanning.</data></edge><edge id="e219" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="method_method_four_phase_compilation_pipeline_7f7d3ce36e"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e220" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="method_method_security_optimizer_631b35c8a9"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A static optimizer that enforces security constraints via Anti-Skill Injection, blocking vulnerabilities before deployment.</data></edge><edge id="e221" source="0008_skcc_portable_and_secure_skill_compilation_for_crossframewor" target="method_method_skir_strongly_typed_intermediate_representation_58498ab028"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A unified intermediate representation that decouples skill semantics from framework-specific formatting, enabling portable deployment across agent frameworks.</data></edge><edge id="e222" source="0009_multiagent_reinforcement_learning_for_maritime_operational_t" target="datasetbenchmark_datasetbenchmark_ipmsrl_8743265944"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">A highly configurable network-based multi-agent RL environment simulating an abstracted generic maritime IPMS where defensive agents attempt to restore an infected network while an attacker propagates.</data></edge><edge id="e223" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="method_method_automated_fleet_security_audit_system_67e92dfa2f"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">An AI agent that continuously scans the fleet for credential exposure, permission drift, and configuration divergence, and remediates findings. It discovered four HIGH severity issues during the 90-day deployment.</data></edge><edge id="e224" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="method_method_credential_proxy_sidecar_7da23a5b9a"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">A sidecar container that proxies credential access, preventing agent containers from directly accessing raw secrets stored in configuration files or environment variables.</data></edge><edge id="e225" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="method_method_kernel_level_workload_isolation_gvisor_112df93782"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Uses gVisor sandboxed containers on Kubernetes to isolate agent workloads at the kernel level, preventing container escapes and limiting the impact of compromised agents.</data></edge><edge id="e226" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="method_method_network_egress_policy_enforcement_7456360c8b"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Kubernetes NetworkPolicy rules restrict each agent's outbound network traffic to allowlisted destinations, preventing data exfiltration to unauthorized external services.</data></edge><edge id="e227" source="0010_caging_the_agents_a_zero_trust_security_architecture_for_aut" target="method_method_prompt_integrity_framework_490b295bb3"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">A framework that uses cryptographically structured metadata envelopes and explicit untrusted content labeling to distinguish trusted instructions from untrusted data, mitigating indirect prompt injection attacks.</data></edge><edge id="e228" source="0012_isolategpt_an_execution_isolation_architecture_for_llmbased" target="method_method_isolategpt_58fd05986c"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e229" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="method_method_agent_empowerment_framework_for_cyber_offense_defense_lifecycle_81198d2706"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">The first agent-empowerment framework aligned with the full cyber offense–defense lifecycle, covering pre-exploitation, initial access &amp; execution, post-exploitation, identification, protection &amp; detection.</data></edge><edge id="e230" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="method_method_structured_literature_review_methodology_6f88630df8"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A structured literature review methodology guided by formal research questions to synthesize existing research, identify critical gaps, and delineate future research trajectories.</data></edge><edge id="e231" source="0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="method_method_taxonomy_of_llm_agent_security_threats_d621086db0"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A taxonomy organized by threat sources, including endogenous, exogenous, and interaction threats, with a mechanistic layer of six foundational architectural failure modes (P1–P6).</data></edge><edge id="e232" source="0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu" target="datasetbenchmark_datasetbenchmark_sola_visibility_ispm_benchmark_c203a025fb"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A benchmark designed to evaluate agentic AI systems on foundational ISPM visibility tasks using a live, production-grade identity environment spanning AWS, Okta, and Google Workspace.</data></edge><edge id="e233" source="0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu" target="method_method_sola_ai_agent_53faf1e4d4"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A tool-using, data-grounded security AI agent that translates natural-language ISPM queries into executable data exploration steps over production IAM, IdP, and SaaS tables, returning verifiable, evidence-backed answers.</data></edge><edge id="e234" source="0015_llm_agents_should_employ_security_principles" target="method_method_agentsandbox_f0b21f909b"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">A conceptual framework embedding security principles (defense-in-depth, least privilege, complete mediation, psychological acceptability) to provide safeguards throughout an agent’s life-cycle. It includes components: Persistent Agent, Data Minimizer, Ephemeral Agent, I/O Firewall, and Response Filter.</data></edge><edge id="e235" source="0016_medical_large_language_models_are_vulnerable_to_datapoisonin" target="method_method_knowledge_graph_based_screening_fdcd709f69"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Proposed a harm mitigation strategy that cross-checks LLM outputs against biomedical knowledge graphs to identify medically harmful content.</data></edge><edge id="e236" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="method_method_mitigation_strategies_e0b1c30e9f"><data key="e_type">proposes</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Ethical prompt engineering, agent systems, and combination, tested to reduce attack success.</data></edge><edge id="e237" source="0018_prompt_injection_attacks_on_vision_language_models_in_oncolo" target="method_method_prompt_injection_attacks_b596c1d520"><data key="e_type">proposes</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Three strategies: text prompt injection, visual prompt injection, and delayed visual prompt injection, with variations in contrast and font size.</data></edge><edge id="e238" source="0022_medical_large_language_models_are_susceptible_to_targeted_mi" target="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e239" source="datasetbenchmark_datasetbenchmark_ipmsrl_8743265944" target="problem_problem_lack_of_marl_environments_for_ot_ecde352fff"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">A highly configurable network-based multi-agent RL environment simulating an abstracted generic maritime IPMS where defensive agents attempt to restore an infected network while an attacker propagates.</data></edge><edge id="e240" source="datasetbenchmark_datasetbenchmark_ipmsrl_8743265944" target="problem_problem_ot_cyber_defence_immaturity_c59d40fc24"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">A highly configurable network-based multi-agent RL environment simulating an abstracted generic maritime IPMS where defensive agents attempt to restore an infected network while an attacker propagates.</data></edge><edge id="e241" source="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b" target="problem_problem_adaptive_cross_session_attacks_1fd36e81e9"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e242" source="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b" target="problem_problem_multi_turn_jailbreaking_8463629096"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e243" source="datasetbenchmark_datasetbenchmark_security_arena_benchmark_c787dea66b" target="problem_problem_prompt_injection_9509944a89"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A 21-scenario benchmark for adaptive cross-session attacks against fresh-session LLM defenders, with configurable attacker and defender models, harnesses, session state, and budgets.</data></edge><edge id="e244" source="datasetbenchmark_datasetbenchmark_sola_visibility_ispm_benchmark_c203a025fb" target="problem_problem_lack_of_standardized_benchmark_for_ispm_visibility_tasks_10e2fe2eec"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A benchmark designed to evaluate agentic AI systems on foundational ISPM visibility tasks using a live, production-grade identity environment spanning AWS, Okta, and Google Workspace.</data></edge><edge id="e245" source="method_method_3_3_attacker_defender_matrix_bab8fdd63d" target="problem_problem_adaptive_cross_session_attacks_1fd36e81e9"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">A controlled evaluation varying three attacker and three defender models under a common scaffold, yielding 945 battles.</data></edge><edge id="e246" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="problem_problem_availability_breakdown_of_execution_b37a7bbf6e"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e247" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="problem_problem_integrity_violation_of_execution_f7e3a2a92a"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e248" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="problem_problem_integrity_violation_of_planning_ea82e27c04"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e249" source="method_method_abstract_concrete_execute_ace_ae2f876efb" target="problem_problem_privacy_compromise_of_execution_c087078050"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0002_ace_a_security_architecture_for_llmintegrated_app_systems</data><data key="e_evidence">A secure architecture that separates planning into abstract plan generation using trusted information, concrete plan instantiation using installed apps, and isolated execution with static information flow verification.</data></edge><edge id="e250" source="method_method_adaptive_cross_session_battles_139da94773" target="problem_problem_adaptive_cross_session_attacks_1fd36e81e9"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0004_adaptive_adversaries_a_multiturn_multillm_benchmark_for_llm</data><data key="e_evidence">Each battle allows up to 15 rounds, with the attacker retaining history and feedback while the defender starts fresh each round.</data></edge><edge id="e251" source="method_method_agent_empowerment_framework_for_cyber_offense_defense_lifecycle_81198d2706" target="problem_problem_llm_agents_empowered_cybersecurity_8a987c2409"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">The first agent-empowerment framework aligned with the full cyber offense–defense lifecycle, covering pre-exploitation, initial access &amp; execution, post-exploitation, identification, protection &amp; detection.</data></edge><edge id="e252" source="method_method_agentsandbox_f0b21f909b" target="problem_problem_lack_of_comprehensive_security_in_llm_agent_protocols_30ecc6ec8e"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">A conceptual framework embedding security principles (defense-in-depth, least privilege, complete mediation, psychological acceptability) to provide safeguards throughout an agent’s life-cycle. It includes components: Persistent Agent, Data Minimizer, Ephemeral Agent, I/O Firewall, and Response Filter.</data></edge><edge id="e253" source="method_method_agentsandbox_f0b21f909b" target="problem_problem_privacy_leakage_in_multi_agent_interactions_f81ccdb1af"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">A conceptual framework embedding security principles (defense-in-depth, least privilege, complete mediation, psychological acceptability) to provide safeguards throughout an agent’s life-cycle. It includes components: Persistent Agent, Data Minimizer, Ephemeral Agent, I/O Firewall, and Response Filter.</data></edge><edge id="e254" source="method_method_agentsandbox_f0b21f909b" target="problem_problem_prompt_injection_and_context_manipulation_vulnerabilities_in_llm_697db33c30"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0015_llm_agents_should_employ_security_principles</data><data key="e_evidence">A conceptual framework embedding security principles (defense-in-depth, least privilege, complete mediation, psychological acceptability) to provide safeguards throughout an agent’s life-cycle. It includes components: Persistent Agent, Data Minimizer, Ephemeral Agent, I/O Firewall, and Response Filter.</data></edge><edge id="e255" source="method_method_automated_fleet_security_audit_system_67e92dfa2f" target="problem_problem_credential_exposure_6a4bbf809d"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">An AI agent that continuously scans the fleet for credential exposure, permission drift, and configuration divergence, and remediates findings. It discovered four HIGH severity issues during the 90-day deployment.</data></edge><edge id="e256" source="method_method_automated_fleet_security_audit_system_67e92dfa2f" target="problem_problem_fleet_configuration_drift_015f9cea98"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">An AI agent that continuously scans the fleet for credential exposure, permission drift, and configuration divergence, and remediates findings. It discovered four HIGH severity issues during the 90-day deployment.</data></edge><edge id="e257" source="method_method_credential_proxy_sidecar_7da23a5b9a" target="problem_problem_credential_exposure_6a4bbf809d"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">A sidecar container that proxies credential access, preventing agent containers from directly accessing raw secrets stored in configuration files or environment variables.</data></edge><edge id="e258" source="method_method_cross_layer_security_framework_1a5a5ac27f" target="problem_problem_lack_of_integrated_security_framework_de7f3e379b"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">An integrated security framework that operates across multiple protocol layers, including components like Trust Framework, Key Management, and Intrusion Detection System.</data></edge><edge id="e259" source="method_method_cross_layer_security_framework_1a5a5ac27f" target="problem_problem_redundant_security_in_layered_approaches_42343037ff"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">An integrated security framework that operates across multiple protocol layers, including components like Trust Framework, Key Management, and Intrusion Detection System.</data></edge><edge id="e260" source="method_method_data_poisoning_attack_simulation_d41f64b50d" target="problem_problem_data_poisoning_vulnerability_in_medical_llms_445267a3b7"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Simulated a data-poisoning attack by replacing a fraction of training tokens in The Pile with AI-generated medical misinformation using the OpenAI GPT-3.5-turbo API.</data></edge><edge id="e261" source="method_method_esaa_security_architecture_64b05a5c72" target="problem_problem_governance_gap_in_agentic_software_engineering_9593de9892"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">A domain-specific specialization of the ESAA governance kernel for security auditing, using append-only event logs, deterministic orchestration, replay verification, and contract-restricted outputs.</data></edge><edge id="e262" source="method_method_esaa_security_architecture_64b05a5c72" target="problem_problem_insecure_ai_generated_code_db9f882957"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">A domain-specific specialization of the ESAA governance kernel for security auditing, using append-only event logs, deterministic orchestration, replay verification, and contract-restricted outputs.</data></edge><edge id="e263" source="method_method_esaa_security_architecture_64b05a5c72" target="problem_problem_weak_prompt_based_security_review_fb1a5bc795"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">A domain-specific specialization of the ESAA governance kernel for security auditing, using append-only event logs, deterministic orchestration, replay verification, and contract-restricted outputs.</data></edge><edge id="e264" source="method_method_farsight_71772324d6" target="problem_problem_domain_agnostic_security_studies_overlook_high_stakes_financial__c53cb3e9ac"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">A scheme-level evaluation framework that scores financial LLM agents on robustness (crash foresight, reaction, loss containment, recovery) and security (attacks on information sources, attacks on agents, agent-as-attacker behaviors) using a reproducible codebook.</data></edge><edge id="e265" source="method_method_farsight_71772324d6" target="problem_problem_lack_of_robustness_in_financial_llm_trading_agents_c13027e740"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">A scheme-level evaluation framework that scores financial LLM agents on robustness (crash foresight, reaction, loss containment, recovery) and security (attacks on information sources, attacks on agents, agent-as-attacker behaviors) using a reproducible codebook.</data></edge><edge id="e266" source="method_method_farsight_71772324d6" target="problem_problem_security_vulnerabilities_in_financial_llm_trading_agents_21d6ebf8ee"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0001_sok_trading_agents_or_market_crashers_dissecting_robustness</data><data key="e_evidence">A scheme-level evaluation framework that scores financial LLM agents on robustness (crash foresight, reaction, loss containment, recovery) and security (attacks on information sources, attacks on agents, agent-as-attacker behaviors) using a reproducible codebook.</data></edge><edge id="e267" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="problem_problem_cross_framework_portability_f5deff2a89"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e268" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="problem_problem_format_sensitivity_90afff1dec"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e269" source="method_method_four_phase_compilation_pipeline_7f7d3ce36e" target="problem_problem_security_vulnerabilities_in_skills_7a3da0a8ac"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A pipeline consisting of Syntax Parser, IR Builder, Security Optimizer, and Target Emitter that reduces adaptation complexity from O(m×n) to O(m+n).</data></edge><edge id="e270" source="method_method_governed_audit_pipeline_2a24f9c16a" target="problem_problem_weak_prompt_based_security_review_fb1a5bc795"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0005_esaasecurity_an_eventsourced_verifiable_architecture_for_age</data><data key="e_evidence">A four-phase pipeline (reconnaissance, domain audit execution, risk classification, final reporting) with 26 tasks, 16 security domains, and 95 executable checks, producing structured outputs from check-level findings to a final risk-oriented report.</data></edge><edge id="e271" source="method_method_intelligent_security_agent_isa_9f11cbef21" target="problem_problem_inability_to_adapt_security_to_application_specific_needs_e1427268d8"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A logical component added to sensor nodes to assess security level needs and manage cross-layer interactions, ensuring energy-efficient and non-redundant security operations.</data></edge><edge id="e272" source="method_method_intelligent_security_agent_isa_9f11cbef21" target="problem_problem_lack_of_integrated_security_framework_de7f3e379b"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A logical component added to sensor nodes to assess security level needs and manage cross-layer interactions, ensuring energy-efficient and non-redundant security operations.</data></edge><edge id="e273" source="method_method_intelligent_security_agent_isa_9f11cbef21" target="problem_problem_redundant_security_in_layered_approaches_42343037ff"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0003_complete_security_framework_for_wireless_sensor_networks</data><data key="e_evidence">A logical component added to sensor nodes to assess security level needs and manage cross-layer interactions, ensuring energy-efficient and non-redundant security operations.</data></edge><edge id="e274" source="method_method_ippo_29c6dd40c3" target="problem_problem_ot_cyber_defence_immaturity_c59d40fc24"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Independent Proximal Policy Optimisation, used as a baseline for comparison against MAPPO.</data></edge><edge id="e275" source="method_method_isolategpt_58fd05986c" target="problem_problem_imprecision_of_natural_language_interfaces_d2dda318aa"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e276" source="method_method_isolategpt_58fd05986c" target="problem_problem_lack_of_isolation_between_apps_and_system_d449113200"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e277" source="method_method_isolategpt_58fd05986c" target="problem_problem_security_and_privacy_risks_in_llm_based_systems_a7ced94e96"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0012_isolategpt_an_execution_isolation_architecture_for_llmbased</data><data key="e_evidence">An execution isolation architecture for LLM-based systems that isolates app execution and mediates interactions through well-defined interfaces with user permission. It uses a hub-and-spoke design: a central hub manages user queries and routes them to appropriate apps, each app runs in a separate spoke with its own LLM instance, and an inter-spoke communication protocol enables safe collaboration between apps.</data></edge><edge id="e278" source="method_method_kernel_level_workload_isolation_gvisor_112df93782" target="problem_problem_execution_capability_abuse_c71ee076eb"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Uses gVisor sandboxed containers on Kubernetes to isolate agent workloads at the kernel level, preventing container escapes and limiting the impact of compromised agents.</data></edge><edge id="e279" source="method_method_knowledge_graph_based_screening_fdcd709f69" target="problem_problem_spread_of_medical_misinformation_by_llms_97824c7f70"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0016_medical_large_language_models_are_vulnerable_to_datapoisonin</data><data key="e_evidence">Proposed a harm mitigation strategy that cross-checks LLM outputs against biomedical knowledge graphs to identify medically harmful content.</data></edge><edge id="e280" source="method_method_llm_based_sast_agent_fb2bc116eb" target="problem_problem_sast_scanning_efficacy_2fbd89b2ad"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0007_can_opensource_llm_agents_replace_static_application_securit</data><data key="e_evidence">A general-purpose GenAI LLM-based agent powered by three different Ollama-hosted open-source models, designed to perform SAST scanning.</data></edge><edge id="e281" source="method_method_mappo_0b5e127e61" target="problem_problem_ot_cyber_defence_immaturity_c59d40fc24"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0009_multiagent_reinforcement_learning_for_maritime_operational_t</data><data key="e_evidence">Multi-Agent Proximal Policy Optimisation with a shared critic implementation, used for training defensive agents.</data></edge><edge id="e282" source="method_method_mitigation_strategies_e0b1c30e9f" target="problem_problem_prompt_injection_vulnerability_in_medical_vlms_99e66eb68d"><data key="e_type">targets</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Ethical prompt engineering, agent systems, and combination, tested to reduce attack success.</data></edge><edge id="e283" source="method_method_network_egress_policy_enforcement_7456360c8b" target="problem_problem_network_egress_exfiltration_661adef28f"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">Kubernetes NetworkPolicy rules restrict each agent's outbound network traffic to allowlisted destinations, preventing data exfiltration to unauthorized external services.</data></edge><edge id="e284" source="method_method_prompt_injection_attacks_b596c1d520" target="problem_problem_prompt_injection_vulnerability_in_medical_vlms_99e66eb68d"><data key="e_type">targets</data><data key="e_conf">1.0</data><data key="e_ctx">0018_prompt_injection_attacks_on_vision_language_models_in_oncolo</data><data key="e_evidence">Three strategies: text prompt injection, visual prompt injection, and delayed visual prompt injection, with variations in contrast and font size.</data></edge><edge id="e285" source="method_method_prompt_integrity_framework_490b295bb3" target="problem_problem_prompt_integrity_failures_7af987f445"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0010_caging_the_agents_a_zero_trust_security_architecture_for_aut</data><data key="e_evidence">A framework that uses cryptographically structured metadata envelopes and explicit untrusted content labeling to distinguish trusted instructions from untrusted data, mitigating indirect prompt injection attacks.</data></edge><edge id="e286" source="method_method_security_optimizer_631b35c8a9" target="problem_problem_security_vulnerabilities_in_skills_7a3da0a8ac"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A static optimizer that enforces security constraints via Anti-Skill Injection, blocking vulnerabilities before deployment.</data></edge><edge id="e287" source="method_method_semi_structured_interviews_a616849fc3" target="problem_problem_intangible_vulnerability_of_emotional_disclosures_19e88ab649"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">Conducted 21 semi-structured interviews with U.S. adults who use general-purpose LLM-enabled chatbots for mental health support to explore their security and privacy perceptions.</data></edge><edge id="e288" source="method_method_semi_structured_interviews_a616849fc3" target="problem_problem_lack_of_empirical_research_on_user_security_and_privacy_concerns_5fbf997091"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">Conducted 21 semi-structured interviews with U.S. adults who use general-purpose LLM-enabled chatbots for mental health support to explore their security and privacy perceptions.</data></edge><edge id="e289" source="method_method_semi_structured_interviews_a616849fc3" target="problem_problem_user_misconceptions_about_data_handling_and_regulatory_protectio_248208bdc9"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0011_exploring_user_security_and_privacy_attitudes_and_concerns_t</data><data key="e_evidence">Conducted 21 semi-structured interviews with U.S. adults who use general-purpose LLM-enabled chatbots for mental health support to explore their security and privacy perceptions.</data></edge><edge id="e290" source="method_method_skir_strongly_typed_intermediate_representation_58498ab028" target="problem_problem_cross_framework_portability_f5deff2a89"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A unified intermediate representation that decouples skill semantics from framework-specific formatting, enabling portable deployment across agent frameworks.</data></edge><edge id="e291" source="method_method_skir_strongly_typed_intermediate_representation_58498ab028" target="problem_problem_format_sensitivity_90afff1dec"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0008_skcc_portable_and_secure_skill_compilation_for_crossframewor</data><data key="e_evidence">A unified intermediate representation that decouples skill semantics from framework-specific formatting, enabling portable deployment across agent frameworks.</data></edge><edge id="e292" source="method_method_sola_ai_agent_53faf1e4d4" target="problem_problem_identity_inventory_and_configuration_hygiene_f6060e6c6a"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A tool-using, data-grounded security AI agent that translates natural-language ISPM queries into executable data exploration steps over production IAM, IdP, and SaaS tables, returning verifiable, evidence-backed answers.</data></edge><edge id="e293" source="method_method_sola_ai_agent_53faf1e4d4" target="problem_problem_lack_of_standardized_benchmark_for_ispm_visibility_tasks_10e2fe2eec"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0014_solavisibilityispm_benchmarking_agentic_ai_for_identity_secu</data><data key="e_evidence">A tool-using, data-grounded security AI agent that translates natural-language ISPM queries into executable data exploration steps over production IAM, IdP, and SaaS tables, returning verifiable, evidence-backed answers.</data></edge><edge id="e294" source="method_method_structured_literature_review_methodology_6f88630df8" target="problem_problem_llm_agents_empowered_cybersecurity_8a987c2409"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A structured literature review methodology guided by formal research questions to synthesize existing research, identify critical gaps, and delineate future research trajectories.</data></edge><edge id="e295" source="method_method_structured_literature_review_methodology_6f88630df8" target="problem_problem_llm_agents_self_security_threats_31187f9f5f"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A structured literature review methodology guided by formal research questions to synthesize existing research, identify critical gaps, and delineate future research trajectories.</data></edge><edge id="e296" source="method_method_targeted_misinformation_attack_via_mlp_weight_modification_296f9ee27b" target="problem_problem_vulnerability_of_medical_llms_to_targeted_misinformation_attacks_53f18bac14"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0022_medical_large_language_models_are_susceptible_to_targeted_mi</data><data key="e_evidence">Modifying the weights of a single multilayer perceptron (MLP) layer in the transformer using gradient-based updates to inject incorrect biomedical facts while preserving other behaviors.</data></edge><edge id="e297" source="method_method_taxonomy_of_llm_agent_security_threats_d621086db0" target="problem_problem_llm_agents_self_security_threats_31187f9f5f"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0013_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A taxonomy organized by threat sources, including endogenous, exogenous, and interaction threats, with a mechanistic layer of six foundational architectural failure modes (P1–P6).</data></edge><edge id="e298" source="method_method_user_relayed_context_manipulation_urecom_3296cbc459" target="problem_problem_context_confusion_in_llm_based_agents_d784d3be2b"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">An attack where attackers manipulate benign users into relaying adversarial content within user requests, relocating external adversarial content into user-provided task context.</data></edge><edge id="e299" source="method_method_user_relayed_context_manipulation_urecom_3296cbc459" target="problem_problem_insufficient_defenses_against_user_relayed_attacks_7cedb46d3c"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0006_agents_at_risk_how_users_unwittingly_undermine_llm_safety</data><data key="e_evidence">An attack where attackers manipulate benign users into relaying adversarial content within user requests, relocating external adversarial content into user-provided task context.</data></edge></graph></graphml>