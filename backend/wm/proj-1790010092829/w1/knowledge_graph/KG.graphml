<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="n_kind" for="node" attr.name="kind" attr.type="string" /><key id="n_label" for="node" attr.name="label" attr.type="string" /><key id="n_type" for="node" attr.name="node_type" attr.type="string" /><key id="n_year" for="node" attr.name="year" attr.type="int" /><key id="n_venue" for="node" attr.name="venue" attr.type="string" /><key id="e_type" for="edge" attr.name="edge_type" attr.type="string" /><key id="e_conf" for="edge" attr.name="confidence" attr.type="double" /><key id="e_ctx" for="edge" attr.name="context_paper_id" attr.type="string" /><key id="e_evidence" for="edge" attr.name="evidence" attr.type="string" /><graph edgedefault="directed"><node id="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse"><data key="n_kind">paper</data><data key="n_label">LLM agents security duality: a comprehensive survey of self-security and empowered cybersecurity</data><data key="n_type">Paper</data><data key="n_year" /><data key="n_venue" /></node><node id="0025_maids_malicious_agent_identificationbased_data_security_mode"><data key="n_kind">paper</data><data key="n_label">MAIDS: Malicious Agent Identification-based Data Security Model for Cloud Environments</data><data key="n_type">Paper</data><data key="n_year" /><data key="n_venue" /></node><node id="limitation_limitation_gap_in_offensive_tasks_for_credential_access_information_disc_b5accd41c3"><data key="n_kind">entity</data><data key="n_label">Gap in offensive tasks for credential access, information discovery, and data theft</data><data key="n_type">Limitation</data><data key="n_year" /><data key="n_venue" /></node><node id="limitation_limitation_lack_of_research_on_adaptive_defense_evasion_b59b2efb56"><data key="n_kind">entity</data><data key="n_label">Lack of research on adaptive defense evasion</data><data key="n_type">Limitation</data><data key="n_year" /><data key="n_venue" /></node><node id="limitation_limitation_propensity_for_errors_in_multi_step_tasks_f2b7ea1bca"><data key="n_kind">entity</data><data key="n_label">Propensity for errors in multi-step tasks</data><data key="n_type">Limitation</data><data key="n_year" /><data key="n_venue" /></node><node id="limitation_limitation_restricted_success_rates_in_lateral_movement_10d42815ff"><data key="n_kind">entity</data><data key="n_label">Restricted success rates in lateral movement</data><data key="n_type">Limitation</data><data key="n_year" /><data key="n_venue" /></node><node id="method_method_agent_eligibility_estimation_aee_c931c01be5"><data key="n_kind">entity</data><data key="n_label">Agent Eligibility Estimation (AEE)</data><data key="n_type">Method</data><data key="n_year" /><data key="n_venue" /></node><node id="method_method_agent_empowerment_framework_aligned_with_full_cyber_offense_defen_3e48746496"><data key="n_kind">entity</data><data key="n_label">Agent-empowerment framework aligned with full cyber offense–defense lifecycle</data><data key="n_type">Method</data><data key="n_year" /><data key="n_venue" /></node><node id="method_method_structured_literature_review_methodology_6f88630df8"><data key="n_kind">entity</data><data key="n_label">Structured literature review methodology</data><data key="n_type">Method</data><data key="n_year" /><data key="n_venue" /></node><node id="method_method_taxonomy_organized_by_threat_sources_2935c12886"><data key="n_kind">entity</data><data key="n_label">Taxonomy organized by threat sources</data><data key="n_type">Method</data><data key="n_year" /><data key="n_venue" /></node><node id="method_method_xgboost_classifier_based_malicious_agent_prediction_xc_map_c538563237"><data key="n_kind">entity</data><data key="n_label">XGBoost Classifier-based Malicious Agent Prediction (XC-MAP)</data><data key="n_type">Method</data><data key="n_year" /><data key="n_venue" /></node><node id="metric_metric_accuracy_f676b93ef9"><data key="n_kind">entity</data><data key="n_label">Accuracy</data><data key="n_type">Metric</data><data key="n_year" /><data key="n_venue" /></node><node id="metric_metric_f1_score_f4f1d4b1e3"><data key="n_kind">entity</data><data key="n_label">F1-score</data><data key="n_type">Metric</data><data key="n_year" /><data key="n_venue" /></node><node id="metric_metric_precision_8d7fae0de9"><data key="n_kind">entity</data><data key="n_label">Precision</data><data key="n_type">Metric</data><data key="n_year" /><data key="n_venue" /></node><node id="metric_metric_recall_9429ac9e55"><data key="n_kind">entity</data><data key="n_label">Recall</data><data key="n_type">Metric</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_data_breaches_by_malicious_agents_in_cloud_environments_b067d1e928"><data key="n_kind">entity</data><data key="n_label">Data breaches by malicious agents in cloud environments</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_llm_agents_empowered_cybersecurity_8a987c2409"><data key="n_kind">entity</data><data key="n_label">LLM agents empowered cybersecurity</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_llm_agents_self_security_threats_31187f9f5f"><data key="n_kind">entity</data><data key="n_label">LLM agents self-security threats</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><node id="problem_problem_reactive_identification_of_malicious_agents_6f7e902c53"><data key="n_kind">entity</data><data key="n_label">Reactive identification of malicious agents</data><data key="n_type">Problem</data><data key="n_year" /><data key="n_venue" /></node><edge id="e1" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="problem_problem_llm_agents_empowered_cybersecurity_8a987c2409"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">The role of LLM agents in empowering the cybersecurity lifecycle across offense and defense.</data></edge><edge id="e2" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="problem_problem_llm_agents_self_security_threats_31187f9f5f"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Threats to LLM agents themselves, including endogenous, exogenous, and interaction threats, and corresponding mitigation strategies.</data></edge><edge id="e3" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="problem_problem_data_breaches_by_malicious_agents_in_cloud_environments_b067d1e928"><data key="e_type">addresses</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Malicious agents may gain unauthorized access to outsourced data, leading to data leakage and misuse.</data></edge><edge id="e4" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="problem_problem_reactive_identification_of_malicious_agents_6f7e902c53"><data key="e_type">addresses</data><data key="e_conf">0.9</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Existing approaches identify malicious agents only after a data leak occurs, which is inadequate for real-time protection.</data></edge><edge id="e5" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_gap_in_offensive_tasks_for_credential_access_information_disc_b5accd41c3"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Research is gap on the offensive tasks that agents perform in credential access, information discovery, and data theft.</data></edge><edge id="e6" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_lack_of_research_on_adaptive_defense_evasion_b59b2efb56"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">There is a lack of research on the adaptive defense evasion capabilities that can respond in real time to proactive defense measures such as EDR (Endpoint Detection and Response).</data></edge><edge id="e7" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_propensity_for_errors_in_multi_step_tasks_f2b7ea1bca"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Current agent-empowered post-exploitation faces limitations, including a propensity for errors in multi-step tasks.</data></edge><edge id="e8" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="limitation_limitation_restricted_success_rates_in_lateral_movement_10d42815ff"><data key="e_type">has_limitation</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">Current agent-empowered post-exploitation faces limitations, including restricted success rates in lateral movement.</data></edge><edge id="e9" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="metric_metric_accuracy_f676b93ef9"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Proportion of correct predictions among total predictions.</data></edge><edge id="e10" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="metric_metric_f1_score_f4f1d4b1e3"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Harmonic mean of precision and recall.</data></edge><edge id="e11" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="metric_metric_precision_8d7fae0de9"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Proportion of true positive predictions among all positive predictions.</data></edge><edge id="e12" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="metric_metric_recall_9429ac9e55"><data key="e_type">measured_by</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Proportion of true positive predictions among all actual positives.</data></edge><edge id="e13" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="method_method_agent_empowerment_framework_aligned_with_full_cyber_offense_defen_3e48746496"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">The first agent-empowerment framework aligned with the full cyber offense–defense lifecycle, covering pre-exploitation, initial access &amp; execution, post-exploitation, identification, protection &amp; detection, and response &amp; recovery.</data></edge><edge id="e14" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="method_method_structured_literature_review_methodology_6f88630df8"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A structured literature review methodology guided by formal research questions to synthesize existing research, identify critical gaps, and delineate future research trajectories.</data></edge><edge id="e15" source="0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse" target="method_method_taxonomy_organized_by_threat_sources_2935c12886"><data key="e_type">proposes</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A taxonomy of LLM agent security threats organized by threat sources, including endogenous, exogenous, and interaction threats.</data></edge><edge id="e16" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="method_method_agent_eligibility_estimation_aee_c931c01be5"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Computes security scores for data requests based on multiple security parameters to assess agent behavior.</data></edge><edge id="e17" source="0025_maids_malicious_agent_identificationbased_data_security_mode" target="method_method_xgboost_classifier_based_malicious_agent_prediction_xc_map_c538563237"><data key="e_type">proposes</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Uses XGBoost machine learning classification to predict malicious agents proactively based on features from AEE.</data></edge><edge id="e18" source="method_method_agent_eligibility_estimation_aee_c931c01be5" target="problem_problem_data_breaches_by_malicious_agents_in_cloud_environments_b067d1e928"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Computes security scores for data requests based on multiple security parameters to assess agent behavior.</data></edge><edge id="e19" source="method_method_agent_empowerment_framework_aligned_with_full_cyber_offense_defen_3e48746496" target="problem_problem_llm_agents_empowered_cybersecurity_8a987c2409"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">The first agent-empowerment framework aligned with the full cyber offense–defense lifecycle, covering pre-exploitation, initial access &amp; execution, post-exploitation, identification, protection &amp; detection, and response &amp; recovery.</data></edge><edge id="e20" source="method_method_structured_literature_review_methodology_6f88630df8" target="problem_problem_llm_agents_empowered_cybersecurity_8a987c2409"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A structured literature review methodology guided by formal research questions to synthesize existing research, identify critical gaps, and delineate future research trajectories.</data></edge><edge id="e21" source="method_method_structured_literature_review_methodology_6f88630df8" target="problem_problem_llm_agents_self_security_threats_31187f9f5f"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A structured literature review methodology guided by formal research questions to synthesize existing research, identify critical gaps, and delineate future research trajectories.</data></edge><edge id="e22" source="method_method_taxonomy_organized_by_threat_sources_2935c12886" target="problem_problem_llm_agents_self_security_threats_31187f9f5f"><data key="e_type">targets</data><data key="e_conf">0.9</data><data key="e_ctx">0023_llm_agents_security_duality_a_comprehensive_survey_of_selfse</data><data key="e_evidence">A taxonomy of LLM agent security threats organized by threat sources, including endogenous, exogenous, and interaction threats.</data></edge><edge id="e23" source="method_method_xgboost_classifier_based_malicious_agent_prediction_xc_map_c538563237" target="problem_problem_data_breaches_by_malicious_agents_in_cloud_environments_b067d1e928"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Uses XGBoost machine learning classification to predict malicious agents proactively based on features from AEE.</data></edge><edge id="e24" source="method_method_xgboost_classifier_based_malicious_agent_prediction_xc_map_c538563237" target="problem_problem_reactive_identification_of_malicious_agents_6f7e902c53"><data key="e_type">targets</data><data key="e_conf">0.95</data><data key="e_ctx">0025_maids_malicious_agent_identificationbased_data_security_mode</data><data key="e_evidence">Uses XGBoost machine learning classification to predict malicious agents proactively based on features from AEE.</data></edge></graph></graphml>